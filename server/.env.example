# ContextSwitch Backend Server Configuration

# Port for the Express REST API (Default: 4000)
PORT=4000

# OpenAI API Key for Codex Reasoning Engine
# If left unset or invalid, the backend automatically uses deterministic grounded reasoning
# to ensure 100% demo safety without failing during presentations.
OPENAI_API_KEY=

# Optional OpenAI model override (Default: gpt-4o)
OPENAI_MODEL=gpt-4o

# SQLite database file path (Default: ./data/contextswitch.db)
DATABASE_PATH=./data/contextswitch.db
